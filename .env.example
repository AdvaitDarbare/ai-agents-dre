# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Use a different model
OPENAI_MODEL_NAME=gpt-4o-mini

# Doris (real cluster) defaults
DRE_DORIS_LOAD_ENABLED=1
DORIS_MOCK_MODE=False
DORIS_AUTO_CREATE_TABLE=1
DORIS_FE_HOST=127.0.0.1
DORIS_FE_HTTP_PORT=8030
DORIS_FE_QUERY_PORT=9030
DORIS_DB=test_db
DORIS_USER=root
DORIS_PASSWORD=
# Useful for Docker Desktop stream-load redirects
DORIS_STREAM_LOAD_REDIRECT_HOST=127.0.0.1
